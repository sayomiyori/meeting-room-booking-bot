# Application
# true — только для локальной разработки без PUBLIC_BASE_URL
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000

# Database (compose service name "postgres" for local)
DATABASE_URL=postgresql+asyncpg://booking:booking@postgres:5432/booking

# Telegram
BOT_TOKEN=changeme
WEBAPP_URL=https://your-https-domain.example
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=  # обязательно сгенерировать: openssl rand -hex 32
# Public base URL for setWebhook (Railway/Render HTTPS). Empty = skip setWebhook (DEBUG polling).
PUBLIC_BASE_URL=

# First admin when users table is empty (your Telegram numeric id).
# Required for the very first boot (empty users table); leave empty temporarily —
# the app still starts and skips bootstrap (no ValidationError).
BOOTSTRAP_ADMIN_TELEGRAM_ID=

# Reminders
REMINDER_MINUTES_BEFORE=10

# No-show auto-cancel (set NO_SHOW_ENABLED=false to disable)
NO_SHOW_ENABLED=true
NO_SHOW_WINDOW_MINUTES=10

# Recurring bookings (Mini App + POST /api/bookings/recurring)
MAX_RECURRING_WEEKS=8

# Auth
# initData max age in seconds (replay protection)
INITDATA_MAX_AGE_SECONDS=300

# Booking grid
SLOT_STEP_MINUTES=30
SOON_FREE_MINUTES=30

# Office hours (wall-clock in OFFICE_TIMEZONE)
OFFICE_TIMEZONE=Europe/Moscow
OFFICE_HOURS_START=9
OFFICE_HOURS_END=18

# Tier 3 — optional LLM /book (leave empty to disable; app boots without it)
# Free key at https://console.groq.com/keys — no credit card / org billing required
GROQ_API_KEY=
# Optional overrides (defaults match llama-3.3-70b-versatile on Groq OpenAI API)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_TIMEOUT_SECONDS=8
# GROQ_MAX_COMPLETION_TOKENS=300
# GROQ_TEMPERATURE=0.2
# DEFAULT_BOOKING_DURATION_MINUTES=60

# Optional error monitoring (leave empty to disable)
# Free tier: https://sentry.io
SENTRY_DSN=
